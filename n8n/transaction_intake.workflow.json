{
  "name": "Fraud-AML Stage 1 - Transaction Intake",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "transaction",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Webhook - Transaction",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "fraud-aml-transaction"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FRAUD_API_URL || 'http://api:8000' }}/api/v1/transactions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Correlation-ID", "value": "={{ $execution.id }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 10000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Call FastAPI Intake",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 500
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "value2": "processed"
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Processed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [720, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.engines.rules.triggered_count }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Any rule triggered?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [960, 200]
    },
    {
      "parameters": {
        "keepOnlySet": false,
        "values": {
          "string": [
            { "name": "workflow_route", "value": "needs_review" },
            { "name": "workflow_note", "value": "One or more rules triggered. This is a routing label, NOT an approve/flag/hold decision (decision engine comes in a later stage)." }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Route: needs_review",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [1200, 120]
    },
    {
      "parameters": {
        "keepOnlySet": false,
        "values": {
          "string": [
            { "name": "workflow_route", "value": "clean" },
            { "name": "workflow_note", "value": "No rule triggered. ML and graph engines are not active yet, so this is NOT an approval." }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Route: clean",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [1200, 280]
    },
    {
      "parameters": {
        "keepOnlySet": false,
        "values": {
          "string": [
            { "name": "workflow_route", "value": "error" },
            { "name": "workflow_note", "value": "API rejected the request (validation failure or id conflict). See status/errors in the body." }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Route: error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [960, 440]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1440, 300]
    }
  ],
  "connections": {
    "Webhook - Transaction": {
      "main": [[{ "node": "Call FastAPI Intake", "type": "main", "index": 0 }]]
    },
    "Call FastAPI Intake": {
      "main": [[{ "node": "Processed?", "type": "main", "index": 0 }]]
    },
    "Processed?": {
      "main": [
        [{ "node": "Any rule triggered?", "type": "main", "index": 0 }],
        [{ "node": "Route: error", "type": "main", "index": 0 }]
      ]
    },
    "Any rule triggered?": {
      "main": [
        [{ "node": "Route: needs_review", "type": "main", "index": 0 }],
        [{ "node": "Route: clean", "type": "main", "index": 0 }]
      ]
    },
    "Route: needs_review": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    },
    "Route: clean": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    },
    "Route: error": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "pinData": {}
}
